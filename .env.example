# Bookify Hotel Reservation System - Environment Variables Template
# Copy this file to .env and update with your actual values

# ==========================================
# Database Configuration
# ==========================================

# SQL Server Connection
DB_SERVER=localhost
DB_NAME=BookifyDB
DB_USER=sa
DB_PASSWORD=YourPassword123!

# Alternative for Windows Authentication (comment out DB_USER and DB_PASSWORD if using this)
# DB_TRUSTED_CONNECTION=True

# Alternative for SQL Server Express
# DB_SERVER=localhost\SQLEXPRESS

# Alternative for LocalDB
# DB_SERVER=(localdb)\mssqllocaldb

# Connection String (will be constructed from above variables)
# Format: Server=${DB_SERVER};Database=${DB_NAME};User Id=${DB_USER};Password=${DB_PASSWORD};TrustServerCertificate=True;

# ==========================================
# JWT Authentication Configuration
# ==========================================

# JWT Secret Key (MUST be at least 32 characters long)
# Generate a secure key: openssl rand -base64 64
JWT_SECRET=YourSuperSecretKeyForJWTAuthenticationMustBeAtLeast32CharactersLongPleaseChangeThis!
JWT_ISSUER=BookifyApi
JWT_AUDIENCE=BookifyClient
JWT_DURATION_MINUTES=60

# ==========================================
# Stripe Payment Configuration
# ==========================================

# Get your keys from: https://dashboard.stripe.com/apikeys
# Use TEST keys for development (start with sk_test_ and pk_test_)
# Use LIVE keys for production (start with sk_live_ and pk_live_)

STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_STRIPE_PUBLISHABLE_KEY_HERE

# Stripe Webhook Secret (for handling payment events)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ==========================================
# Application Configuration
# ==========================================

# Application URLs
APP_HTTP_URL=http://localhost:5080
APP_HTTPS_URL=https://localhost:7280

# Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# Allowed Hosts (comma-separated)
ALLOWED_HOSTS=*

# ==========================================
# Email Configuration (if implemented)
# ==========================================

# SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=noreply@bookify.com
SMTP_FROM_NAME=Bookify Hotel Reservation

# ==========================================
# Logging Configuration
# ==========================================

# Log Level (Trace, Debug, Information, Warning, Error, Critical)
LOG_LEVEL=Information
LOG_PATH=Logs/bookify-.txt

# ==========================================
# Session Configuration
# ==========================================

SESSION_TIMEOUT_MINUTES=30

# ==========================================
# CORS Configuration
# ==========================================

# Allowed Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ==========================================
# Health Check Configuration
# ==========================================

HEALTH_CHECK_PATH=/health

# ==========================================
# File Upload Configuration
# ==========================================

# Maximum file size in MB
MAX_FILE_SIZE_MB=10

# Allowed file extensions (comma-separated)
ALLOWED_FILE_EXTENSIONS=.jpg,.jpeg,.png,.pdf

# Upload directory
UPLOAD_DIRECTORY=wwwroot/uploads

# ==========================================
# Cache Configuration
# ==========================================

# Cache expiration in minutes
CACHE_EXPIRATION_MINUTES=60

# ==========================================
# Rate Limiting (if implemented)
# ==========================================

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60

# ==========================================
# Additional Notes
# ==========================================

# SECURITY WARNINGS:
# 1. NEVER commit the actual .env file to version control
# 2. Add .env to your .gitignore file
# 3. Use different values for Development, Staging, and Production
# 4. Keep your JWT_SECRET and STRIPE keys secure
# 5. Rotate your secrets regularly
# 6. Use strong passwords for database access

# DEVELOPMENT TIPS:
# 1. Use Trusted_Connection=True for local Windows development
# 2. Use Stripe TEST keys (not LIVE) during development
# 3. Set ASPNETCORE_ENVIRONMENT=Development for detailed error pages
# 4. Check logs in the Logs/ directory for troubleshooting

# PRODUCTION CHECKLIST:
# □ Use strong, unique passwords
# □ Switch to Stripe LIVE keys
# □ Set ASPNETCORE_ENVIRONMENT=Production
# □ Disable detailed error messages
# □ Enable HTTPS only
# □ Configure proper CORS origins
# □ Set up proper logging and monitoring
# □ Enable rate limiting
# □ Regular security audits
